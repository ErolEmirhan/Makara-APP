# MAKARA Club Firebase projesi (Firebase Console → Proje ayarları → Web uygulaması)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Yerel geliştirme: `npx firebase-tools emulators:start --only auth,firestore` ile birlikte
# VITE_FIREBASE_EMULATORS=true

# Ürün fotoğrafları için Cloudflare R2 (yalnızca npm run sync:images kullanır, uygulamaya girmez)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=makara
